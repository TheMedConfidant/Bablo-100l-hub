{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/practicals/",
      "destination": "/practicals/index.html"
    },
    {
      "source": "/arcade",
      "destination": "/bablo-arcade.html"
    },
    {
      "source": "/arcade/",
      "destination": "/bablo-arcade.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
